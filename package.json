{
  "name": "danang-bridges-3d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gen:voice": "node scripts/gen-narration.mjs",
    "test:tour": "node tests/tour-check.mjs",
    "test:voice": "node tests/voice-check.mjs",
    "test:drawcalls": "node tests/drawcalls.mjs",
    "test:tunnel": "node tests/tunnel-check.mjs",
    "test:riverfront": "node tests/riverfront-check.mjs",
    "test:weather": "node tests/weather-check.mjs",
    "test:mobile": "node tests/mobile-check.mjs",
    "test:sunwheel": "node tests/sunwheel-check.mjs",
    "test:perf": "node tests/perf-check.mjs",
    "test:explore": "node tests/explore-check.mjs",
    "test:citynight": "node tests/citynight-check.mjs",
    "test:multi": "node tests/multi-check.mjs",
    "test:multi:unit": "tsx --test tests/multi-unit/*.test.ts",
    "test:multi:worker": "node tests/multi-unit/worker.integration.mjs",
    "test:boats:unit": "tsx --test tests/boats-unit/*.test.ts",
    "test:boats": "node tests/boats-check.mjs",
    "test:traffic:unit": "tsx --test tests/traffic-unit/*.test.ts",
    "test:traffic": "node tests/traffic-check.mjs",
    "test:trees:unit": "tsx --test tests/trees-unit/*.test.ts",
    "test:people:unit": "tsx --test tests/people-unit/*.test.ts"
  },
  "dependencies": {
    "three": "^0.165.0"
  },
  "devDependencies": {
    "@types/three": "^0.165.0",
    "msedge-tts": "^2.1.0",
    "playwright": "^1.56.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^6.4.4"
  }
}
